# Environment Configuration Template
# Copy this to .env and update with your values

# Flask Configuration
FLASK_APP=src/main.py
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_TESTING=False

# Secret Keys (CHANGE THESE IN PRODUCTION)
SECRET_KEY=your-secret-key-change-in-production-12345
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production-12345

# Database Configuration
DATABASE_URL=postgresql://cyber_user:cyber_password@localhost:5432/cyber_threat_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security Settings
DATA_ENCRYPTION_ENABLED=True
LOCAL_DATA_VAULT_ONLY=True
ENABLE_AUDIT_LOGGING=True

# Authorization & Defense Settings
DEFAULT_AUTHORIZATION_TIMEOUT=600
CRITICAL_THREAT_TIMEOUT=120
HIGH_THREAT_TIMEOUT=300
MEDIUM_THREAT_TIMEOUT=600
LOW_THREAT_TIMEOUT=1200
DEFAULT_FAIL_SAFE_ACTION=PAUSE

# Data Retention (days)
TELEMETRY_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/application.log

# Feature Flags
ENABLE_COLLECTIVE_INTELLIGENCE=True
ENABLE_FEDERATED_LEARNING=False
ENABLE_PATTERN_SHARING=True

# Certification Status
CERTIFICATION_READY=True
CERTIFIED=False

# API Configuration
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4

# Email/Notifications (Optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=security-team@yourdomain.com
